// VideoCraft AI - Prisma Schema
// Database: SQLite for dev, PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// User Model
// ===========================================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  googleId  String   @unique @map("google_id")
  credits   Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  conversations   Conversation[]
  characters      Character[]
  videos          Video[]
  styleReferences StyleReference[]

  @@map("users")
}

// ===========================================
// Conversation Model
// ===========================================
model Conversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("New Conversation")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  videos   Video[]

  @@map("conversations")
}

// ===========================================
// Message Model
// ===========================================
model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   // 'user' | 'assistant' | 'system'
  content        String
  mediaUrls      String   @default("[]") @map("media_urls") // JSON string
  createdAt      DateTime @default(now()) @map("created_at")

  // Relationships
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ===========================================
// Video Model
// ===========================================
model Video {
  id                 String    @id @default(uuid())
  conversationId     String    @map("conversation_id")
  userId             String    @map("user_id")
  prompt             String
  model              String    // 'veo3_1' | 'runway' | 'luma' | 'sora' | 'odyssey' | 'world_labs'
  duration           Int       // seconds (1-30)
  videoUrl           String?   @map("video_url")
  thumbnailUrl       String?   @map("thumbnail_url")
  status             String    @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  qualityScore       Float?    @map("quality_score") // 0-10
  qualityReport      String?   @map("quality_report") // JSON string
  styleReferenceUrls String    @default("[]") @map("style_reference_urls") // JSON string
  characterIds       String    @default("[]") @map("character_ids") // JSON string
  metadata           String?   // JSON string for model-specific params
  createdAt          DateTime  @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")

  // Relationships
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("videos")
}

// ===========================================
// Character Model
// ===========================================
model Character {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  name              String
  description       String
  referenceImageUrl String?  @map("reference_image_url")
  gcsImageUri       String?  @map("gcs_image_uri") // gs:// URI for Veo (Google Cloud Storage)
  embeddingData     String?  @map("embedding_data") // JSON string
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("characters")
}

// ===========================================
// Style Reference Model
// ===========================================
model StyleReference {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  sourceUrl      String   @map("source_url")
  sourceType     String   @map("source_type") // 'upload' | 'youtube'
  colorPalette   String?  @map("color_palette") // JSON string
  styleEmbedding String?  @map("style_embedding") // JSON string
  createdAt      DateTime @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("style_references")
}

// ===========================================
// Generation Job Model (for queue management)
// ===========================================
model GenerationJob {
  id             String    @id @default(uuid())
  videoId        String    @unique @map("video_id")
  status         String    @default("queued") // 'queued' | 'processing' | 'completed' | 'failed' | 'cancelled'
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  externalJobId  String?   @map("external_job_id") // Model provider's job ID
  webhookPayload String?   @map("webhook_payload") // JSON string
  createdAt      DateTime  @default(now()) @map("created_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@map("generation_jobs")
}
