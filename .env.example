# ===========================================
# VideoCraft AI - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Database (Supabase Postgres)
DATABASE_URL="postgresql://user:password@host:5432/videocraft"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google AI API (powers Veo video generation & Gemini quality analysis)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY="your-google-ai-api-key"
# Note: GEMINI_API_KEY also works for backwards compatibility

# Google Cloud Project (required for Veo 3.1 via Vertex AI)
# Get your project ID from: https://console.cloud.google.com
GOOGLE_CLOUD_PROJECT_ID="your-project-id"

# Google Cloud Storage (required for Veo character references)
# Create a bucket at: https://console.cloud.google.com/storage
GOOGLE_CLOUD_STORAGE_BUCKET="your-bucket-name"

# YouTube Data API (for reference video search)
YOUTUBE_API_KEY="your-youtube-api-key"

# Other AI Model APIs (optional)
RUNWAY_API_KEY="your-runway-key"
LUMA_API_KEY="your-luma-key"
OPENAI_API_KEY="your-openai-key"

# Queue (Upstash Redis)
UPSTASH_REDIS_URL="your-redis-url"
UPSTASH_REDIS_TOKEN="your-redis-token"

# Analytics
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Payments (optional for MVP)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudflare R2 (video storage)
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="videocraft-videos"
R2_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
